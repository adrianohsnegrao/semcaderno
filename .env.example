# Local production-like stack
POSTGRES_DB=sem_caderno
POSTGRES_USER=sem_caderno
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://sem_caderno:change-this-local-password@database:5432/sem_caderno
SEM_CADERNO_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Set to true only behind HTTPS. docker-compose.yml keeps it false for localhost.
SEM_CADERNO_SECURE_COOKIES=false

# Managed PostgreSQL providers commonly require this value.
SEM_CADERNO_DATABASE_SSL=disable
